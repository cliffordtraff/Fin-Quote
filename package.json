{
  "name": "fin-quote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:next": "next dev --port 3000",
    "dev:clean": "pkill -f 'next dev' 2>/dev/null; sleep 1; rm -rf .next; next dev",
    "postinstall": "patch-package",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .next/cache/eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "export": "npx tsx scripts/export-to-excel.ts",
    "export:catalog": "npx tsx scripts/export-metrics-catalog.ts",
    "setup:metrics": "npx tsx scripts/setup-financial-metrics.ts",
    "fetch:metrics": "npx tsx scripts/fetch-fmp-metrics.ts",
    "ingest:metrics": "npx tsx scripts/ingest-fmp-metrics.ts",
    "generate:catalog": "npx tsx scripts/generate-metrics-catalog.ts",
    "refresh:stocks": "npx tsx scripts/us-stocks/refresh-registry.ts",
    "stocks:status": "npx tsx scripts/us-stocks/check-status.ts",
    "ingest:segments": "npx tsx scripts/ingest-segment-data-all.ts",
    "wiim:warm": "npx tsx scripts/warm-wiim-cache.ts",
    "wiim:brief": "npx tsx scripts/run-wiim-brief.ts",
    "wiim:generate-daily": "npx tsx scripts/generate-daily-wiim-summaries.ts",
    "wiim:summarize-warm": "npx tsx scripts/summarize-wiim-warm-run.ts",
    "wiim:summarize-debug": "npx tsx scripts/summarize-finviz-debug.ts",
    "newsletter:run-automation": "npx tsx scripts/run-daily-newsletter-automation.ts",
    "newsletter:run-mid-morning": "npx tsx scripts/run-mid-morning-newsletter-automation.ts",
    "newsletter:verify-daily": "npx tsx scripts/verify-daily-newsletter-run.ts",
    "verify:catalyst-newsletter": "npx tsx scripts/verify-catalyst-newsletter-workflow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.4.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.39.3",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/ws": "^8.18.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.2.3",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "lightweight-charts": "^5.0.9",
    "liveline": "^0.0.6",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "openai": "^6.8.0",
    "puppeteer": "^24.39.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typed.js": "^2.1.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.16.0",
    "@types/react": "npm:types-react@^19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@^19.0.0-rc.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.17",
    "cheerio": "^1.1.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.6",
    "exceljs": "^4.4.0",
    "jsdom": "^27.1.0",
    "patch-package": "^8.0.1",
    "pg": "^8.17.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.8",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
}
