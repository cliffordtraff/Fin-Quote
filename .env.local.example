# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional cookie domain for shared auth across subdomains
# Example: .theintraday.com
NEXT_PUBLIC_COOKIE_DOMAIN=

# Supabase Service Role Key (for server-side scripts that bypass RLS)
# WARNING: Never expose this to the browser - server-side only!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
# This is a server-side secret — never expose to the browser
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model Configuration
# Specify which model to use for chat completions
# Options: gpt-4o-mini, gpt-5-nano, gpt-5-mini, gpt-5, gpt-4o
# Default: gpt-5-nano (60% cheaper than gpt-4o-mini)
OPENAI_MODEL=gpt-5-nano

# Financial Modeling Prep API Key
# Get this from: https://financialmodelingprep.com/developer/docs
# This is a server-side secret — never expose to the browser
FMP_API_KEY=your-fmp-api-key-here

# Massive (formerly Polygon.io) API Key
# Get this from: https://massive.com (real-time WebSocket + REST market data)
# Required for: live streaming on /dashboard/live, real-time quotes
MASSIVE_API_KEY=your-massive-api-key-here

# Data Provider
# Which provider to use for market data REST calls
# Options: fmp (default, uses FMP_API_KEY), massive (uses MASSIVE_API_KEY)
DATA_PROVIDER=fmp

# Feature Flags
# Set to 'true' to enable the AI chatbot feature (Chat tab + /chatbot route)
NEXT_PUBLIC_ENABLE_CHAT=false

# Set to 'true' to show the landing page at `/` instead of the dashboard
NEXT_PUBLIC_ENABLE_LANDING=false

# Set to 'true' to show the legacy stock page tab in navigation
NEXT_PUBLIC_SHOW_STOCK_V1=false

# Toggle certain movers-related UI on the dashboard
NEXT_PUBLIC_ENABLE_MOVERS=true

# Charting Platform integration
# Used for embedded workspace routes, stock search integration, and chart embeds
NEXT_PUBLIC_CHARTING_URL=http://localhost:3001

# Optional public charting URL override for published newsletters.
# Use this when capture runs against localhost but final links should point at production.
NEWSLETTER_PUBLIC_CHARTING_URL=https://charts.theintraday.com

# Optional Dexter / research-agent integration
# Used by /api/dexter-query and the separate dexter/ package
EXA_API_KEY=
TAVILY_API_KEY=
FINANCIAL_DATASETS_API_KEY=
DEXTER_MODEL=gpt-4o
DEXTER_MODEL_PROVIDER=openai
